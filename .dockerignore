# The build stage copies Cargo.toml, Cargo.lock, build.rs and src/ explicitly,
# so this list is a second line of defence rather than the mechanism. It matters
# most for `target/`, which is large and whose host artifacts are useless to a
# musl cross-build.
target/

.git/
.gitignore
.github/
.claude/

# The operator's own configuration and the Miniserver dump it names. Neither
# belongs in an image; the config is mounted at runtime.
config/
fixtures/

# The configuration test corpus. Read by the tests, not needed to build.
golden/

# Editor and tooling leftovers.
.vscode/
.idea/
*.log
logs/
