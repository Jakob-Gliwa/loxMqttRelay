.DS_Store

# Logs
*.log
logs/

# The operator's own configuration, and the Miniserver dump it names. Both
# describe somebody's actual house - rooms, devices, serials - so neither is
# checked in. `config/default_config.toml` is the sample to copy.
config/config.toml
config/sps0.LoxCC

# Somewhere to drop further real Miniserver payloads. The whitelist tests pick
# them up if they are here and skip if they are not; see
# `whitelist::tests::the_real_configuration_yields_its_inputs`.
fixtures/

# Local benchmark harnesses and their captures. Useful, large, and specific to
# whoever ran them.
benchmarks/
benchmark.py
newbench.py

# Left over from the build this project used to have. None of it is read any
# more; the whole lot is safe to delete.
.migration-leftovers/
build/
dist/
__pycache__/
*.py[cod]
*.egg-info/
.coverage
.pytest_cache/
.ruff_cache/
.venv/

# Scratch
ref/
Temp/

# Cargo.lock is tracked on purpose: a published release has to be rebuildable
# from its tag, which floating dependency resolution would not be.
